<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except plain HTTP is allowed so the app can reach the server on a home/office LAN
     (e.g. http://192.168.1.20:8080) during setup. Use your public HTTPS URL in production. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
